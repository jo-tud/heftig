# Heftig configuration. Copy to .env and adjust. All variables are optional.
# Language, AI, e-mail and scanner are easier to set on the setup/settings pages in the browser;
# a variable set here wins over the settings page (and is shown there as fixed).
# Full list with defaults: src/heftig/config.py (and docs/operations.md, docs/providers.md).

# --- Language --------------------------------------------------------------------------
# en | de: interface, and the language of AI-written titles and summaries
# HEFTIG_LANGUAGE=en

# --- Storage ---------------------------------------------------------------------------
# Native installation: where the archive lives (in containers this is fixed to /archive).
# HEFTIG_ARCHIVE_DIR=./archive
# Watched input folder (scanner share). Default: <archive>/consume
# HEFTIG_CONSUME_DIR=/mnt/scanner

# Optional second watched folder for digital files (source "folder", no paper filing).
# HEFTIG_FOLDER_DIR=/home/me/Documents/Heftig-Inbox

# Compose only: host directories that are mounted into the containers.
# HEFTIG_ARCHIVE_HOST_DIR=./archive
# HEFTIG_CONSUME_HOST_DIR=./consume
# HEFTIG_FOLDER_HOST_DIR=./folder
# Compose only: published port. Keep 127.0.0.1 unless you want LAN access (docs/operations.md).
# HEFTIG_PUBLISH=127.0.0.1:8765

# --- Web -------------------------------------------------------------------------------
# HEFTIG_HOST=127.0.0.1
# HEFTIG_PORT=8765
# Behind a TLS reverse proxy: trust X-Forwarded-* headers (sets Secure cookies automatically)
# HEFTIG_TRUST_PROXY_HEADERS=false
# HEFTIG_COOKIE_SECURE=auto

# --- Limits ----------------------------------------------------------------------------
# HEFTIG_MAX_UPLOAD_MB=100
# HEFTIG_MAX_PAGES=500
# HEFTIG_MAX_IMAGE_MEGAPIXELS=150
# HEFTIG_WORKER_CONCURRENCY=2

# --- Scanner folder / paper filing -------------------------------------------------------
# HEFTIG_CONSUME_POLL_SECONDS=10
# HEFTIG_CONSUME_AFTER=delete          # or "move" (into .heftig-verarbeitet/)
# a PDF/JPEG not finished yet (multi-page scan with pauses) is waited for this long:
# HEFTIG_CONSUME_INCOMPLETE_WAIT_SECONDS=900
# automatic consistent database copy (archive/backup/index-snapshot.sqlite), 0 = off:
# HEFTIG_DB_SNAPSHOT_HOURS=6
# Mark paper as filed immediately when it arrives from these sources (simple scanner routine):
# HEFTIG_AUTO_FILE_SOURCES=scanner
# HEFTIG_FILING_GRANULARITY=month      # or "year"

# --- Text extraction (OCR) ---------------------------------------------------------------
# tesseract (offline, default) | none | openai | anthropic | openai_compatible | mock
# HEFTIG_OCR_PROVIDER=tesseract
# HEFTIG_OCR_LANGUAGES=deu+eng
# Cloud OCR sends page images to the provider. Must be switched on explicitly:
# HEFTIG_ALLOW_CLOUD_OCR=false
# HEFTIG_OCR_MODEL=
# Anthropic only: a stronger model just for page 1 (letterhead, sender, date, subject), e.g.
# HEFTIG_OCR_MODEL=claude-sonnet-5 plus HEFTIG_OCR_FIRST_PAGE_MODEL=claude-opus-5-5
# HEFTIG_OCR_FIRST_PAGE_MODEL=
# Cloud OCR: pages recognised in parallel per document, long side of the images sent
# HEFTIG_OCR_PAGE_CONCURRENCY=3
# HEFTIG_OCR_MAX_SIDE=2000
# Cost guards for cloud OCR: pages with less ink are read locally; max AI pages per document
# HEFTIG_OCR_BLANK_MAX_INK=0.001
# HEFTIG_OCR_AI_MAX_PAGES=30
# HEFTIG_OCR_BASE_URL=
# HEFTIG_OCR_API_KEY_FILE=/run/secrets/ocr_api_key
# Additional HTTP headers for an openai/openai_compatible endpoint (secret like the key):
# one "Name: value" per line or a JSON object (docs/providers.md#additional-http-headers)
# HEFTIG_OCR_HEADERS={"x-example-session": "heftig"}
# HEFTIG_OCR_HEADERS_FILE=/run/secrets/ocr_headers
# HEFTIG_OCR_SUPPORTS_IMAGES=true

# --- Classification (title, date, correspondent, type, tags, summary, fields) ------------
# rules (offline, pattern based, default) | none | openai | anthropic | openai_compatible | mock
# HEFTIG_CLASSIFY_PROVIDER=rules
# Cloud classification sends the extracted text to the provider. Must be switched on explicitly:
# HEFTIG_ALLOW_CLOUD_CLASSIFY=false
# HEFTIG_CLASSIFY_MODEL=
# HEFTIG_CLASSIFY_BASE_URL=
# HEFTIG_CLASSIFY_API_KEY_FILE=/run/secrets/classify_api_key
# HEFTIG_CLASSIFY_HEADERS={"x-example-session": "heftig"}
# HEFTIG_CLASSIFY_HEADERS_FILE=/run/secrets/classify_headers
# HEFTIG_CLASSIFY_JSON_MODE=schema     # schema | object | none (for endpoints without JSON schema)
# HEFTIG_CLASSIFY_MIN_CONFIDENCE=0.6
# AI search (✦ KI, request -> filters) with Anthropic: a small fast model
# HEFTIG_AI_SEARCH_MODEL=claude-haiku-4-5-20251001

# Search by meaning (docs/search.md): a built-in model on this computer, downloaded once
# (about 330 MB). Off unless switched on here or in the setup assistant / settings.
# HEFTIG_SEMANTIC_SEARCH=false
# HEFTIG_SEMANTIC_THREADS=0               # CPU threads for the model, 0 = half the cores

# When a remote AI provider is unreachable: process locally now, redo with AI later
# HEFTIG_AI_FALLBACK=true
# HEFTIG_AI_RETRY_MINUTES=60

# Example: local model via Ollama (vision model for OCR, any chat model for classification)
# HEFTIG_OCR_PROVIDER=openai_compatible
# HEFTIG_OCR_BASE_URL=http://host.docker.internal:11434/v1
# HEFTIG_OCR_MODEL=<local-vision-model>
# HEFTIG_CLASSIFY_PROVIDER=openai_compatible
# HEFTIG_CLASSIFY_BASE_URL=http://host.docker.internal:11434/v1
# HEFTIG_CLASSIFY_MODEL=<local-chat-model>

# Example: Anthropic in the cloud (explicit opt-in)
# HEFTIG_CLASSIFY_PROVIDER=anthropic
# HEFTIG_CLASSIFY_MODEL=claude-opus-5-5
# HEFTIG_CLASSIFY_API_KEY_FILE=/run/secrets/anthropic_key
# HEFTIG_ALLOW_CLOUD_CLASSIFY=true

# --- E-mail (IMAP) -------------------------------------------------------------------------
# HEFTIG_IMAP_HOST=imap.example.org
# HEFTIG_IMAP_PORT=993
# HEFTIG_IMAP_USER=archiv@example.org
# HEFTIG_IMAP_PASSWORD_FILE=/run/secrets/imap_password
# HEFTIG_IMAP_MAILBOX=INBOX
# HEFTIG_IMAP_MOVE_TO=Archiviert
# Dedicated mailbox only: delete mails whose documents are all archived (to the server's trash
# folder if it has one, else expunged). Mails with refused attachments are kept.
# HEFTIG_IMAP_DELETE_AFTER_IMPORT=false
# HEFTIG_IMAP_TRASH_MAILBOX=
# HEFTIG_IMAP_POLL_SECONDS=300
# HEFTIG_IMAP_SKIP_INLINE_IMAGES_BELOW_KB=30
# HEFTIG_IMAP_SKIP_FILENAME_PATTERNS=logo*,image0*,signature*
# HEFTIG_IMAP_ARCHIVE_EML=false
# this word in the subject: the (forwarded) e-mail itself is archived, text and attachments in
# one document; empty = off
# HEFTIG_IMAP_MAIL_KEYWORD=#mail
# who may send documents (addresses and/or @domain); empty = anyone who knows the address
# HEFTIG_IMAP_ALLOWED_SENDERS=ich@example.org,@meine-bank.example
# HEFTIG_IMAP_MAX_ATTACHMENTS=20

# HEFTIG_LOG_LEVEL=INFO
